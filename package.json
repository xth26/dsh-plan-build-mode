                                                              },
                                 "@deepseek-ai/dsh-storage-domain":  {
                                                                         "optional":  true
                                                                     },
                                 "@deepseek-ai/dsh-system-prompt":  {
                                                                        "optional":  true
                                                                    },
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            },
                                 "zod":  {
                                             "optional":  true
                                         }
                             },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "4.0.5",
